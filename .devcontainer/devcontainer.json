{
  "name": "BIGBIIM",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "service": "workspace",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "remoteUser": "node",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "forwardPorts": [
    8080,
    3000,
    3001,
    4000,
    9001
  ],
  "portsAttributes": {
    "8080": {
      "label": "Plateforme complète (Traefik)",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "Web client / prestataire"
    },
    "3001": {
      "label": "Admin (/admin)"
    },
    "4000": {
      "label": "API"
    },
    "9001": {
      "label": "Console MinIO"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "prisma.prisma",
        "bradlc.vscode-tailwindcss",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib",
        "files.eol": "\n"
      }
    }
  }
}
