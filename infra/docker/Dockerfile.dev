# Image de développement unique (api, worker, web, admin, workspace).
FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git openssl ca-certificates curl procps \
    && rm -rf /var/lib/apt/lists/*

# Le volume node_modules hérite de ce dossier et de son propriétaire (utilisateur node).
RUN mkdir -p /workspace/node_modules && chown -R node:node /workspace

WORKDIR /workspace
USER node
ENV npm_config_update_notifier=false
