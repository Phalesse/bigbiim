// Modèles de données BIGBIIM — section 4 du document de spécification.
// Conventions : identifiants UUID (à passer en UUID v7 côté application), dates en UTC,
// montants en entiers (unités mineures, BigInt) + devise ISO, suppression logique (deletedAt),
// createdAt / updatedAt / version (verrouillage optimiste), country_code sur les entités régionales.
// Aucune relation Prisma n'est déclarée : les clés étrangères sont des champs *Id simples.
// À vous d'ajouter les @relation et les index au fil du codage.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Section 4.1
model User {
  id String @id @default(uuid())
  phone String?
  email String?
  passwordHash String?
  status String
  locale String
  type String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version Int @default(1)
  deletedAt DateTime?
}

// Section 4.1
model Role {
  id String @id @default(uuid())
  userId String
  role String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version Int @default(1)
  deletedAt DateTime?
  @@index([userId])
}

// Section 4.1
model Permission {
  id String @id @default(uuid())
