# Variables d'environnement de développement.
# Compose fournit les services locaux ; configurez OIDC avant d’utiliser les routes privées.
NODE_ENV=development
DATABASE_URL=postgresql://bigbiim:bigbiim@postgres:5432/bigbiim?schema=public
REDIS_URL=redis://redis:6379
NATS_URL=nats://nats:4222
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=bigbiim
S3_SECRET_KEY=bigbiim-secret
S3_BUCKET=bigbiim
GOTENBERG_URL=http://gotenberg:3000
API_PORT=4000
OIDC_ISSUER_URL=
OIDC_AUDIENCE=bigbiim-api
OIDC_JWKS_URL=
# Client OIDC public de l'interface d'administration (Authorization Code + PKCE, sans secret client).
OIDC_ADMIN_CLIENT_ID=
# URI publique facultative ; par défaut : https://<plateforme>/admin/auth/callback
OIDC_ADMIN_REDIRECT_URI=
# Opérateurs de paiement, SMS, WhatsApp : à renseigner quand vous coderez les intégrations
PAYMENT_OPERATOR_API_KEY=
SMS_GATEWAY_API_KEY=
WHATSAPP_API_TOKEN=
